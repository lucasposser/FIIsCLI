# Opcional — o site funciona sem este arquivo.
# Pensado para viver numa SUBPASTA (ex.: public_html/fii/): não declara
# autenticação nem DirectoryIndex, então herda o que a raiz já define.

Options -Indexes

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # O JSON da API manda Cache-Control: no-store pelo próprio PHP.
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
